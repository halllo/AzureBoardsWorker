# npm on Windows runs scripts through cmd.exe, which cannot execute scripts/abw.sh.
# Pin Git bash explicitly: a bare `bash` on Windows resolves to
# C:\Windows\System32\bash.exe (the WSL launcher), which would run the script in
# a different filesystem without az/node. Forward slashes avoid quoting issues
# with the space in "Program Files". Harmless on Linux/macOS, where npm uses sh.
script-shell=C:/Program Files/Git/bin/bash.exe
