# Copy to .env (gitignored) and fill in.

# --- LLM provider: "openai" (default) or "bedrock" ---------------------------
ABW_PROVIDER=openai

# OpenAI (ABW_PROVIDER=openai). Never commit the real key.
OPENAI_API_KEY=

# AWS Bedrock (ABW_PROVIDER=bedrock): a named profile (aws sso login /
# ~/.aws/credentials) is preferred; never put access keys in files you commit.
# AWS_PROFILE=bedrock
# AWS_REGION=eu-central-1          # defaults to eu-central-1 when unset

# Azure DevOps. The agent's own identity: either `az login` as that account, or a PAT for it.
AZDO_ORG=https://dev.azure.com/<org>/
AZDO_PROJECT=
AZDO_TEAM=
ABW_IDENTITY=            # unique name / email of the agent account (the @Me of the board)
# AZURE_DEVOPS_EXT_PAT=  # PAT of the agent account (Work Items R/W, Code R/W, PR threads)

# Optional Entra agent identity authentication. Set this instead of
# AZURE_DEVOPS_EXT_PAT to acquire a short-lived Azure DevOps token before every
# manager tick. ENTRA_AGENT_BLUEPRINT_SECRET must be provided from a secure local secret
# source; do not commit it.
# ABW_AUTH=entra-agent
# ENTRA_TENANT_ID=
# ENTRA_AGENT_IDENTITY=  # agent identity object ID
# ENTRA_AGENT_USER_ID=   # agent user object ID
# ENTRA_AGENT_BLUEPRINT_ID=
# ENTRA_AGENT_BLUEPRINT_SECRET=

# Optional
# ABW_HOME=~/.abw        # mirror clones + worktrees

# Model overrides. Unset = the defaults for the selected ABW_PROVIDER:
#   openai  -> manager openai/gpt-5.6-terra, worker openai/gpt-5.6-sol, small openai/gpt-5.6-luna
#   bedrock -> manager amazon-bedrock/eu.anthropic.claude-sonnet-5,
#              worker  amazon-bedrock/eu.anthropic.claude-opus-5,
#              small   amazon-bedrock/eu.anthropic.claude-haiku-4-5-20251001-v1:0
# ABW_MANAGER_MODEL=
# ABW_WORKER_MODEL=
# ABW_SMALL_MODEL=
